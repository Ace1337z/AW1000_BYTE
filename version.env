# BYTE by ACE firmware version.
#
# Rendered in LuCI -> Status -> Overview as "Firmware Version":
#
#     BYTE 25.12(6.12.94) 1.2.1
#     \___/ \___/ \______/ \___/
#       |     |       |      |
#       |     |       |      +-- FW_CODE  (patch, derived)
#       |     |       +--------- kernel of the build (read from the tree)
#       |     +----------------- release series
#       +----------------------- distro name
#
# FW_PATCH is NOT edited by hand. It is the number of commits since FW_BASE,
# so every pushed commit moves the firmware version by one:
#
#     commit adding this file  -> 1.2.1
#     next commit              -> 1.2.2
#     next commit              -> 1.2.3
#
# FW_BASE is the commit immediately before this file existed. Keep it fixed;
# if history is ever rewritten (squash/rebase of everything), set FW_BASE to
# the new tip and set FW_PATCH_FALLBACK to the patch number that tip should
# report.
#
# FW_PATCH_FALLBACK is used when the version cannot be derived - no git
# history (tarball export) or HEAD still sitting on FW_BASE with uncommitted
# changes. It equals the patch of the next commit.
#
# Bump FW_MINOR (and reset the base/fallback) only for a deliberate
# feature-level release, never for a routine commit.

FW_MAJOR=1
FW_MINOR=2
FW_BASE=efc387c80cb210759fc31569d4f7646d839271a6
FW_PATCH_FALLBACK=1
