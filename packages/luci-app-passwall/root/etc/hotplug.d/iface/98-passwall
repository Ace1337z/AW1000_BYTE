#!/bin/sh
# Restart the tunnel only on a real WAN change, never on every ifup event.
# The modem interface renews DHCP/RA often and the old unconditional restart
# dropped a healthy tunnel every few minutes (looked like random disconnects).

[ "$ACTION" = "ifup" ] || exit 0
[ "$(uci get passwall.@global[0].enabled)" = "1" ] || exit 0
[ -f /var/lock/passwall_ready.lock ] || exit 0

default_device=$(ip route | grep default | awk -F 'dev ' '{print $2}' | awk '{print $1}')
[ "$default_device" = "$DEVICE" ] || exit 0

STAMP=/tmp/.passwall_ifup
now=$(date +%s)
last=0
lastip=""
if [ -f "$STAMP" ]; then
	last=$(cut -d'|' -f1 "$STAMP" 2>/dev/null)
	lastip=$(cut -d'|' -f2 "$STAMP" 2>/dev/null)
fi
case "$last" in ''|*[!0-9]*) last=0;; esac
wanip=$(ip -4 addr show "$DEVICE" 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)

# Tunnel is up, the WAN address is unchanged and we restarted recently: skip.
if pgrep -f "passwall/bin/xray" >/dev/null 2>&1 && [ "$wanip" = "$lastip" ] && [ $((now - last)) -lt 600 ]; then
	logger -p notice -t network "passwall: ifup on $DEVICE ignored (tunnel up, WAN unchanged)"
	exit 0
fi

echo "$now|$wanip" > "$STAMP"
/etc/init.d/passwall restart
logger -p notice -t network "passwall: restart on $INTERFACE ifup (wan $wanip)"
