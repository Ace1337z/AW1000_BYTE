#!/bin/sh
# XtraJoss helper: exit IP / country / hosting org / node name / live status.
# Usage: /cgi-bin/pw-exit?app=passwall|passwall2   (default: auto)
# Status is checked per app; geo answers are cached per IP.
echo "Content-Type: application/json"
echo "Cache-Control: no-store"
echo

app=$(echo "$QUERY_STRING" | sed -n 's/.*app=\(passwall2\?\).*/\1/p')
case "$app" in
	passwall|passwall2) ;;
	*)
		app=passwall
		if [ "$(uci -q get passwall.@global[0].enabled)" != "1" ] && [ "$(uci -q get passwall2.@global[0].enabled)" = "1" ]; then
			app=passwall2
		fi
		;;
esac

socks=$(uci -q get $app.@global[0].tcp_node_socks_port)
case "$socks" in ''|*[!0-9]*) socks=1070 ;; esac
node=$(uci -q get $app.@global[0].tcp_node)
srv=""; port=""; name=""
if [ -n "$node" ] && [ "$node" != "nil" ]; then
	srv=$(uci -q get $app.$node.address)
	port=$(uci -q get $app.$node.port)
	name=$(uci -q get $app.$node.remarks)
fi
addr="$srv"
case "$srv" in *:*) addr="[$srv]" ;; esac
[ -n "$port" ] && addr="$addr:$port"

cache=/tmp/.pw_exit_$app
geocache=/etc/pw_geo_cache
ttl=3
now=$(date +%s)
if [ -f "$cache" ]; then
	ts=$(cut -d'|' -f1 "$cache" 2>/dev/null)
	case "$ts" in ''|*[!0-9]*) ts=0;; esac
	if [ $((now - ts)) -lt $ttl ]; then
		cut -d'|' -f2- "$cache"
		exit 0
	fi
fi

okfile=/tmp/.pw_ok_$app
lastok=0
lastip=""
if [ -f "$okfile" ]; then
	lastok=$(cut -d'|' -f1 "$okfile" 2>/dev/null)
	lastip=$(cut -d'|' -f2 "$okfile" 2>/dev/null)
fi
case "$lastok" in ''|*[!0-9]*) lastok=0;; esac

status="disconnected"
ip=""
if [ "$(uci -q get $app.@global[0].enabled)" = "1" ]; then
	ip=$(curl -s --max-time 6 --socks5-hostname 127.0.0.1:$socks https://api.ipify.org 2>/dev/null)
	case "$ip" in ''|*[!0-9a-fA-F.:]*) ip="";; esac
	if [ -n "$ip" ]; then
		status="connected"
		echo "$now|$ip" > "$okfile"
	elif [ $((now - lastok)) -lt 25 ]; then
		# One failed probe right after a restart must not flicker the pill.
		status="connected"
		ip="$lastip"
	fi
fi
[ -n "$ip" ] || ip=$(curl -s --max-time 4 https://api.ipify.org 2>/dev/null)
case "$ip" in ''|*[!0-9a-fA-F.:]*) ip="";; esac

cc=""; org=""
if [ -n "$ip" ]; then
	line=$(grep -m1 "^$ip|" "$geocache" 2>/dev/null)
	if [ -n "$line" ]; then
		cc=$(echo "$line" | cut -d'|' -f2)
		org=$(echo "$line" | cut -d'|' -f3)
	else
		j=$(curl -s --max-time 5 "http://ip-api.com/json/$ip?fields=countryCode,org,isp" 2>/dev/null)
		cc=$(echo "$j" | sed -n 's/.*"countryCode"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p')
		org=$(echo "$j" | sed -n 's/.*"org"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		isp=$(echo "$j" | sed -n 's/.*"isp"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		# ip-api sometimes returns a bare country code as "org"; prefer the ISP name then
		[ ${#org} -le 4 ] && org="$isp"
		[ -n "$org" ] || org="$isp"
		[ -n "$cc" ] || cc=$(curl -s --max-time 4 "https://ipapi.co/$ip/country/" 2>/dev/null)
		[ -n "$org" ] || org=$(curl -s --max-time 4 "https://ipinfo.io/$ip/org" 2>/dev/null | sed 's/^AS[0-9]* //')
		cc=$(echo "$cc" | tr a-z A-Z | tr -cd 'A-Z')
		case "$cc" in
			[A-Z][A-Z]) echo "$ip|$cc|$org" >> "$geocache" ;;
			*) cc="" ;;
		esac
	fi
fi
# short provider label: "Leaseweb Asia Pacific Pte. Ltd." -> "Leaseweb"
short=$(echo "$org" | sed 's/,.*//' | awk '{print $1}')
case "$short" in ''|*[!A-Za-z0-9.-]*) short="$org" ;; esac
# a very short first word ("GB") reads better with its qualifier ("GB Network")
if [ ${#short} -le 4 ]; then
	two=$(echo "$org" | sed 's/,.*//' | awk '{print $1" "$2}')
	[ -n "$two" ] && short="$two"
fi

printf '%s|{"ip":"%s","cc":"%s","org":"%s","server":"%s","addr":"%s","name":"%s","status":"%s","app":"%s"}\n' \
	"$now" "$ip" "$cc" "$short" "$srv" "$addr" "$name" "$status" "$app" > "$cache"
cut -d'|' -f2- "$cache"
