#!/bin/sh
# rpcd backend for luci-app-modeminfo (BYTE build).
#
# The AT collector (/usr/bin/modeminfo) costs several AT round trips, so it is
# never run from cron or a daemon: this plugin runs it on demand and caches the
# result for the refresh interval in /etc/config/modeminfo. The UI polls
# `status`; while the cache is younger than the interval the call is free.
#
# Methods:
#   status                 parsed snapshot + meta (cache age, port, source)
#   ports                  available AT ports and the configured one
#   set_port {port}        persist the AT port
#   set_interval {seconds} persist the refresh interval (2-60)
#   history                RSRP/SINR samples from /tmp/aw1000-status/history
#   sample                 force a refresh now

. /usr/share/libubox/jshn.sh

CACHE=/tmp/modeminfo
HIST=/tmp/aw1000-status/history
SRC_LIVE=/tmp/aw1000-status/live
LOCK=/var/lock/modeminfo.lock
PORT_DEFAULT=/dev/ttyUSB3

list_methods() {
	cat <<'EOF'
{
	"status": { },
	"ports": { },
	"set_port": { "port": "string" },
	"set_interval": { "seconds": "integer" },
	"history": { },
	"sample": { }
}
EOF
}

interval() {
	local n
	n=$(uci -q get modeminfo.settings.refresh_rate)
	case "$n" in '' | *[!0-9]*) n=5 ;; esac
	[ "$n" -lt 2 ] && n=2
	[ "$n" -gt 60 ] && n=60
	echo "$n"
}

port() {
	local p
	p=$(uci -q get modeminfo.settings.comm)
	[ -n "$p" ] || p="$PORT_DEFAULT"
	echo "$p"
}

age() {
	local m now
	m=$(stat -c %Y "$1" 2>/dev/null) || { echo 999999; return; }
	now=$(date +%s)
	echo $((now - m))
}

# The collector prints its snapshot on stdout; keep the last one in $CACHE so a
# 2 s UI poll does not re-run it. When /tmp/aw1000-status/live exists the
# collector only reads that file (no AT traffic at all), so the write below is
# a cheap re-parse; when the fallback path had to poll the modem this cache is
# what keeps two browser tabs from double-driving the serialiser.
collect() {
	(
		flock -n 9 || exit 0
		/bin/sh /usr/bin/modeminfo >"$CACHE.$$" 2>/dev/null
		if [ -s "$CACHE.$$" ]; then
			mv "$CACHE.$$" "$CACHE"
		else
			rm -f "$CACHE.$$"
		fi
	) 9>>"$LOCK"
}

# stale: yes when the snapshot should be rebuilt - first call, interval expired,
# or byte-status-cache wrote a newer sample than the one already parsed.
stale() {
	local iv
	iv=$(interval)
	[ -s "$CACHE" ] || return 0
	[ "$(age "$CACHE")" -ge "$iv" ] && return 0
	# Compare mtimes numerically: busybox `test -nt` is not guaranteed to be
	# compiled in, while `stat -c %Y` already backs age() above.
	[ "$(stat -c %Y "$SRC_LIVE" 2>/dev/null || echo 0)" -gt \
	  "$(stat -c %Y "$CACHE" 2>/dev/null || echo 0)" ] && return 0
	return 1
}

# keymap <"Key Name"> -> key_name (lowercase, non-alnum -> underscore)
keymap() {
	printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cs 'a-z0-9' '_' |
		sed -e 's/^_*//' -e 's/_*$//'
}

do_status() {
	local iv p a src fresh avail
	iv=$(interval)
	p=$(port)
	stale && collect
	fresh=0 avail=0 src=cache
	if [ -s "$CACHE" ]; then
		avail=1
		fresh=1
	fi
	# Report the age of the data, not of the parse: the shared cache is written
	# every 10 s, so that is the number the operator cares about.
	if [ -s "$SRC_LIVE" ]; then
		a=$(age "$SRC_LIVE")
		[ "$a" -gt $((iv * 4 + 20)) ] && fresh=0
	else
		a=$(age "$CACHE")
		src=at
	fi

	json_init
	json_add_object "meta"
	# "cache" means the numbers came from byte-status-cache without touching
	# the AT port; "at" means the collector had to poll the modem itself.
	json_add_string "source" "$src"
	json_add_string "port" "$p"
	json_add_int "interval" "$iv"
	json_add_int "age" "$a"
	json_add_int "fresh" "$fresh"
	json_add_int "available" "$avail"
	json_close_object

	json_add_object "modem"
	if [ -s "$CACHE" ]; then
		local line k v key
		while IFS= read -r line; do
			case "$line" in
			PCC:* | SCC[0-9]*:*) continue ;;
			esac
			k=${line%%:*}
			v=${line#*: }
			key=$(keymap "$k")
			[ -n "$key" ] && json_add_string "$key" "$v"
		done <"$CACHE"
	fi
	json_close_object

	json_add_array "carriers"
	if [ -s "$CACHE" ]; then
		local c
		while IFS= read -r c; do
			json_add_string "" "$c"
		done <<EOF
$(grep -E '^(PCC|SCC[0-9]+):' "$CACHE" 2>/dev/null)
EOF
	fi
	json_close_array

	json_dump
}

# History is one line per poll: "<epoch> <mode> <lte rsrp> <nr rsrp>
# <lte sinr> <nr sinr>" with "-" for values the modem did not report. The
# collector never writes it, byte-status-cache does; this only serves it.
do_history() {
	local t mode l n ls ns
	json_init
	json_add_array "points"
	if [ -s "$HIST" ]; then
		while read -r t mode l n ls ns; do
			case "$t" in '' | *[!0-9]*) continue ;; esac
			json_add_object ""
			json_add_int "t" "$t"
			json_add_string "mode" "${mode:--}"
			json_add_string "lte_rsrp" "${l:--}"
			json_add_string "nr_rsrp" "${n:--}"
			json_add_string "lte_sinr" "${ls:--}"
			json_add_string "nr_sinr" "${ns:--}"
			json_close_object
		done <"$HIST"
	fi
	json_close_array
	json_dump
}
do_ports() {
	local f p
	p=$(port)
	json_init
	json_add_string "current" "$p"
	json_add_array "ports"
	for f in /dev/ttyUSB* /dev/ttyACM*; do
		[ -c "$f" ] && json_add_string "" "$f"
	done
	json_close_array
	json_dump
}

do_set_port() {
	local p
	json_load "$(cat)"
	json_get_var p port
	case "$p" in
	/dev/ttyUSB[0-9]* | /dev/ttyACM[0-9]*) ;;
	*)
		json_init
		json_add_boolean "ok" 0
		json_add_string "message" "invalid port"
		json_dump
		return
		;;
	esac
	uci -q set modeminfo.settings.comm="$p"
	uci -q commit modeminfo
	rm -f "$CACHE"
	json_init
	json_add_boolean "ok" 1
	json_add_string "message" "port saved"
	json_dump
}

do_set_interval() {
	local n
	json_load "$(cat)"
	json_get_var n seconds
	case "$n" in '' | *[!0-9]*) n=5 ;; esac
	[ "$n" -lt 2 ] && n=2
	[ "$n" -gt 60 ] && n=60
	uci -q set modeminfo.settings.refresh_rate="$n"
	uci -q commit modeminfo
	json_init
	json_add_boolean "ok" 1
	json_add_int "interval" "$n"
	json_dump
}

case "$1" in
list) list_methods ;;
call)
	shift
	case "$1" in
	status) do_status ;;
	ports) do_ports ;;
	set_port) do_set_port ;;
	set_interval) do_set_interval ;;
	history) do_history ;;
	sample) rm -f "$CACHE"; collect; do_status ;;
	esac
	;;
*) list_methods ;;
esac
