#!/bin/sh
# BYTE by ACE - size the WAN egress queue from the link's own traffic.
#
# Why this exists at all: 1.2.37 shipped `tc qdisc replace ... fq limit 1981`
# on wwan0 and wwan0_1 with the limit derived from a GUESSED uplink_kbit
# 200000. At a real 20 Mbit that is ~1.2 s of standing queue in our own qdisc,
# and it was applied by the interface hotplug path, so every redial rebuilt
# the queue. Both halves were wrong.
#
# What this does instead:
#   1. measures the uplink passively - no probe traffic, no external server,
#      no dependency on anything outside the box. It samples tx_bytes of the
#      interface that actually carries IP (wwan0_1 when the mux exists),
#   2. keeps the best observed 5 s average (raise-only, 15 % margin, so a slow
#      sample cannot shrink the queue and a real one is recorded once),
#   3. converts it to a packet count covering 60 ms of link at 1538 B/frame,
#      clamped to 128..2000 packets,
#   4. applies it, and re-applies only when the limit live on the device
#      differs from the computed one - so a unit that never uploads keeps the
#      kernel default and pays nothing, a reboot or redial that drops the
#      qdisc gets the bound back on the next round, and a steady link sees no
#      `tc` call at all.
#
# Two stages, because this is how the driver actually queues:
#   app -> wwan0_1 qdisc -> qmimux_start_xmit -> skb->dev=wwan0 ->
#   dev_queue_xmit (drivers/net/usb/qmi_wwan.c) -> wwan0 qdisc -> USB.
# Both qdiscs hold packets, so both are bounded: the child to the measured
# BDP (that is the queue that matters), the parent to a fixed 64 packets
# (only enough to keep the USB URBs fed).
#
# fq (not fq_codel) deliberately: without `maxrate` fq does not shape, so
# throughput is never capped. All this changes is how much of OUR OWN queue
# can accumulate before tail drop. The modem's internal buffer is downstream
# and is not reachable from here - fixing that requires shaping, i.e. SQM,
# which this image does not ship by policy.

STATE_DIR=/etc/byte
STATE=$STATE_DIR/fq.state
SAMPLE_SECS=5
INTERVAL=300
BDP_MS=60
FRAME_BYTES=1538
PARENT_LIMIT=64
MIN_LIMIT=128
MAX_LIMIT=2000
TAG=byte-fq

log() {
	logger -t "$TAG" "$*"
}

# Interface that carries IP: the mux child when qmi_wwan created one,
# otherwise whatever the default route points at, otherwise the first
# wwan/rmnet device with a carrier.
wan_dev() {
	local d
	d=$(ip -4 route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)
	case "$d" in
		wwan*|rmnet*) [ -e "/sys/class/net/$d" ] && { echo "$d"; return; } ;;
	esac
	for d in wwan0_1 wwan0; do
		[ -e "/sys/class/net/$d/statistics/tx_bytes" ] && { echo "$d"; return; }
	done
	for d in /sys/class/net/wwan* /sys/class/net/rmnet*; do
		[ -e "$d" ] || continue
		echo "${d##*/}"
		return
	done
}

# qmimux child -> parent. Only one level exists on this driver.
parent_dev() {
	case "$1" in
		*_[0-9]*) echo "${1%_*}" ;;
		*) echo "" ;;
	esac
}

read_state() {
	local k v
	BEST_KBIT=0
	APPLIED_LIMIT=0
	APPLIED_DEV=
	[ -f "$STATE" ] || return 0
	while IFS='=' read -r k v; do
		case "$k" in
			best_kbit) BEST_KBIT=$v ;;
			limit) APPLIED_LIMIT=$v ;;
			dev) APPLIED_DEV=$v ;;
		esac
	done < "$STATE"
	case "$BEST_KBIT" in ''|*[!0-9]*) BEST_KBIT=0 ;; esac
	case "$APPLIED_LIMIT" in ''|*[!0-9]*) APPLIED_LIMIT=0 ;; esac
}

write_state() {
	mkdir -p "$STATE_DIR" 2>/dev/null
	{
		echo "best_kbit=$BEST_KBIT"
		echo "limit=$APPLIED_LIMIT"
		echo "dev=$APPLIED_DEV"
		echo "updated=$(date +%s)"
	} > "$STATE.tmp" 2>/dev/null && mv -f "$STATE.tmp" "$STATE" 2>/dev/null
}

# Packets per band that cover BDP_MS of the measured link, at FRAME_BYTES.
limit_for() {
	local kbit="$1" pkts
	pkts=$(( kbit * 1000 / 8 * BDP_MS / 1000 / FRAME_BYTES ))
	[ "$pkts" -lt "$MIN_LIMIT" ] && pkts=$MIN_LIMIT
	[ "$pkts" -gt "$MAX_LIMIT" ] && pkts=$MAX_LIMIT
	echo "$pkts"
}

sample_kbit() {
	local dev="$1" b0 b1
	b0=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null) || return 1
	sleep "$SAMPLE_SECS"
	b1=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null) || return 1
	case "$b0$b1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$b1" -ge "$b0" ] || return 1
	echo $(( (b1 - b0) * 8 / 1000 / SAMPLE_SECS ))
}

apply_parent() {
	local parent cur
	parent=$(parent_dev "$1")
	[ -n "$parent" ] || return 0
	[ -d "/sys/class/net/$parent/queues" ] || return 0
	# Idempotent: qdiscs do not survive a reboot, so this runs at every start,
	# but `replace` drops whatever is in flight - only touch it when the live
	# parent is not already our fixed bound.
	cur=$(tc qdisc show dev "$parent" 2>/dev/null | head -1)
	case "$cur" in
		*qdisc\ fq*limit\ "$PARENT_LIMIT"p*) return 0 ;;
	esac
	if tc qdisc replace dev "$parent" root fq limit "$PARENT_LIMIT" 2>/dev/null; then
		log "parent $parent limited to $PARENT_LIMIT pkts"
	fi
}

apply_child() {
	local dev="$1" limit="$2"
	[ -n "$limit" ] || return 0
	if tc qdisc replace dev "$dev" root fq limit "$limit" 2>/dev/null; then
		APPLIED_LIMIT=$limit
		APPLIED_DEV=$dev
		write_state
		log "$dev fq limit=$limit (best uplink ${BEST_KBIT} kbit)"
		return 0
	fi
	log "$dev tc failed, keeping kernel default qdisc"
	return 1
}

once() {
	local dev kbit limit
	dev=$(wan_dev)
	[ -n "$dev" ] || return 1
	read_state
	# Parent stage at every start: a reboot loses the qdisc, and the check in
	# apply_parent() keeps this from dropping packets when it is already right.
	apply_parent "$dev"
	# Sample first: returning early on "no measurement yet" would mean never
	# measuring anything, because the only writer of best_kbit is this sample.
	if kbit=$(sample_kbit "$dev"); then
		if [ "$kbit" -gt $(( BEST_KBIT * 115 / 100 )) ]; then
			BEST_KBIT=$kbit
			write_state
		fi
	fi
	# Still idle, or an empty state on a box that has not uploaded yet: leave
	# the kernel default fq (limit 10000) alone. Nothing is guessed.
	[ "$BEST_KBIT" -gt 0 ] || return 0
	limit=$(limit_for "$BEST_KBIT")
	# Compare against the LIVE qdisc, not the state file: a reboot (or a
	# qmodem redial that recreates the mux) drops the qdisc while the state
	# still claims a limit, and then the bound would silently never come back.
	live=$(tc qdisc show dev "$dev" 2>/dev/null | head -1 | \
		sed 's/flow_limit [0-9]*p//g' | \
		sed -n 's/.*[^_]limit \([0-9][0-9]*\)p.*/\1/p')
	if [ "$live" != "$limit" ]; then
		apply_child "$dev" "$limit"
	fi
	return 0
}

case "$1" in
	--set)
		# Manual override, e.g. after a speed test: byte-fq-learn --set 35000
		case "$2" in ''|*[!0-9]*) echo "usage: $0 --set <uplink-kbit>"; exit 1 ;; esac
		read_state
		BEST_KBIT=$2
		APPLIED_LIMIT=0
		APPLIED_DEV=
		write_state
		dev=$(wan_dev)
		[ -n "$dev" ] || { echo "no WAN netdev yet"; exit 1; }
		apply_parent "$dev"
		apply_child "$dev" "$(limit_for "$BEST_KBIT")"
		exit 0
		;;
	--show)
		read_state
		echo "best_uplink_kbit=$BEST_KBIT limit=$APPLIED_LIMIT dev=$APPLIED_DEV"
		dev=$(wan_dev)
		[ -n "$dev" ] && tc qdisc show dev "$dev" 2>/dev/null | head -2
		exit 0
		;;
esac

# Wait (bounded) for the modem netdev, then loop slowly. The loop is one
# tx_bytes read per sample and one tc call only when the decision changes -
# it never touches netifd, never calls ifup, and never runs from a hotplug.
waited=0
while [ "$waited" -lt 120 ]; do
	[ -n "$(wan_dev)" ] && break
	sleep 3
	waited=$((waited + 3))
done
[ -n "$(wan_dev)" ] || log "no WAN netdev after 120s, waiting for default route"

while :; do
	once || true
	sleep "$INTERVAL"
done
