#!/bin/sh
# BYTE by ACE - report the WAN egress queue and what it costs in latency.
#
# Read-only: it changes no setting. Use it before and after tuning
# /etc/config/byte to see whether the queue bound is actually holding.
#
#   byte-fq-measure              # 100 pings to the default gateway and 1.1.1.1
#   byte-fq-measure 200 8.8.8.8  # 200 pings to a specific target
#
# What to look for:
#   - `backlog` under a saturating upload: with the shipped limit (about 2000
#     packets at 200 Mbit/40 ms) it should stay in the low hundreds, and the
#     p99 RTT should not grow by more than the configured flow_limit allows.
#   - `drops`: fq drops only when the aggregate limit is exceeded, which means
#     uplink_kbit is set higher than the real bearer.
#   - p50/p99 delta between idle and loaded is the number that matters. A
#     bufferbloat problem shows up as p99 +100 ms or worse; a tick-rate or CPU
#     problem does not show up here at all.

COUNT=${1:-100}
TARGET=${2:-}
GWDIR=/proc/sys/net/core

pct() {
	# pct <file-of-numbers> <percentile>
	sort -n "$1" 2>/dev/null | awk -v p="$2" '
		{ v[NR] = $1 }
		END {
			if (NR == 0) { print "n/a"; exit }
			i = int((p / 100) * NR)
			if (i < 1) i = 1
			if (i > NR) i = NR
			printf "%.1f", v[i]
		}'
}

sample() {
	# sample <label> <target>
	local label="$1" tgt="$2" f out
	f=$(mktemp) || return
	out=$(ping -c "$COUNT" -i 0.05 -W 1 "$tgt" 2>/dev/null)
	printf '%s\n' "$out" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' > "$f"
	if [ -s "$f" ]; then
		printf '  %-18s n=%-4s p50=%-7s p95=%-7s p99=%-7s max=%s\n' \
			"$label" "$(wc -l < "$f")" \
			"$(pct "$f" 50)" "$(pct "$f" 95)" "$(pct "$f" 99)" \
			"$(sort -n "$f" | tail -1)"
	else
		printf '  %-18s no replies\n' "$label"
	fi
	rm -f "$f"
}

echo "== qdisc =="
found=0
for dev in /sys/class/net/wwan*; do
	[ -e "$dev" ] || continue
	found=1
	name=${dev##*/}
	echo "-- $name"
	tc -s qdisc show dev "$name" 2>/dev/null | sed 's/^/   /'
done
[ "$found" = 1 ] || echo "   no wwan interface (modem not dialled?)"

echo
echo "== tuning in effect =="
for k in default_qdisc busy_poll busy_read netdev_budget netdev_budget_usecs; do
	[ -r "$GWDIR/$k" ] && printf '   %-22s %s\n' "$k" "$(cat "$GWDIR/$k" 2>/dev/null)"
done
printf '   %-22s %s\n' "byte.fq.enabled" "$(uci -q get byte.fq.enabled 2>/dev/null)"
printf '   %-22s %s\n' "byte.fq.uplink_kbit" "$(uci -q get byte.fq.uplink_kbit 2>/dev/null)"
printf '   %-22s %s\n' "byte.fq.rtt_ms" "$(uci -q get byte.fq.rtt_ms 2>/dev/null)"
printf '   %-22s %s\n' "byte.fq.flow_limit" "$(uci -q get byte.fq.flow_limit 2>/dev/null)"
printf '   %-22s %s\n' "byte.fq.initial_quantum" "$(uci -q get byte.fq.initial_quantum 2>/dev/null)"

echo
echo "== latency, idle ($COUNT pings) =="
gw=$(ip route show default 2>/dev/null | awk '/^default/ {print $3; exit}')
[ -n "$gw" ] && sample "gateway($gw)" "$gw"
sample "1.1.1.1" 1.1.1.1
[ -n "$TARGET" ] && sample "$TARGET" "$TARGET"

echo
echo "Run the same command again while an upload is saturating the link:"
echo "  tcpdump-free:  dd if=/dev/zero bs=1M count=200 | nc <host> <port>"
echo "or simply push a large file from a LAN client. The p99 delta between the"
echo "two runs is the queueing delay the bound is there to cap."
