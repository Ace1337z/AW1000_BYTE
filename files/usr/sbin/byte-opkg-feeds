#!/bin/sh
# Build the opkg feed list for BYTE by ACE.
#
# Two sources, for two different jobs:
#
#   1. Our own repo (raw.githubusercontent.com, branch 'repo'): kernel-pinned
#      kmods and the packages that only exist in this project (qmodem/SMS, the
#      AW1000 phone stack, our themes, modeminfo, nikki/mihomo). kmods MUST
#      come from here - a kmod built against another kernel makes opkg abort
#      with "Not downgrading package kernel".
#
#   2. ImmortalWrt 24.10.6 opkg feeds: the eight on-demand apps (banIP,
#      SmartDNS, SQM, mwan3, OpenClash, HomeProxy) plus their luci frontends and
#      userland libraries. 25.12 publishes apk only, so the last opkg branch is
#      used. Its packages are Architecture: all or plain userland, and it shares
#      musl 1.2.5 with this image, so they are compatible.
#
# Base-files generates /etc/opkg/distfeeds.conf from CONFIG_VERSION_REPO; this
# script replaces it because the image needs BOTH sets of feeds.

KODS="https://raw.githubusercontent.com/Ace1337z/AW1000_BYTE/repo"
IMM="https://downloads.immortalwrt.org/releases/24.10.6"
A="aarch64_cortex-a53"

gen() {
	# 1) our repo (raw.githubusercontent.com). Same directory layout as the ImmortalWrt feeds.
	echo "src/gz byte_by_ace_core $KODS/targets/qualcommax/ipq807x/packages"
	# Only feeds our repo actually publishes. Empty feeds (routing, telephony,
	# video) are deliberately omitted: jsDelivr 404s a directory with no files,
	# and opkg reports that as a failed feed.
	for f in base dotycat fxs luci nikki nss packages passwall_luci qmodem vantage; do
		echo "src/gz byte_by_ace_$f $KODS/packages/$A/$f"
	done

	# 2) ImmortalWrt 24.10.6 opkg feeds (userland + the eight apps).
	for f in base luci packages routing telephony; do
		echo "src/gz immortalwrt_$f $IMM/packages/$A/$f"
	done
}

gen > /etc/opkg/distfeeds.conf

# Keep the signing key for the official feeds. 3fd9011f340b50dd signs the
# 24.10 release packages; without it opkg discards every 24.10.6 index with
# "Signature check failed" and quietly leaves /var/opkg-lists empty.
[ -s /etc/opkg/keys/3fd9011f340b50dd ] || \
	logger -t byte-opkg "missing 24.10 signing key; official feeds will fail verification"

logger -t byte-opkg "distfeeds: our repo (kmods) + ImmortalWrt 24.10.6 ($(grep -c src/gz /etc/opkg/distfeeds.conf) feeds)"
exit 0
