#!/bin/sh
# NSS/ECM status and manual override for the AW1000.
#
# Policy (2026-11-02): NSS/ECM is ALWAYS ON. It accelerates bridge,
# LAN<->WiFi and local flows. The TTL/HopLimit rewrite (luci-app-qmodem-ttlfw4)
# is a netfilter rule, and an accelerated flow bypasses netfilter - so modem
# egress (wwan*, rmnet*) is excluded from acceleration inside ECM itself
# (qca-nss-ecm patch 0027). Those netdevs are registered as UNKNOWN with an
# invalid accelerator ifnum, the NSS rule create is rejected and the flow stays
# on the host stack, where the rewrite always applies.
#
# Nothing needs to be disabled to get a correct TTL on the wire. Prefer LuCI:
# Network -> Modem -> TTL Configuration switches the rewrite on/off and leaves
# NSS alone.
#
# Usage:
#   nss-offload status   show ECM / accel / TTL state
#   nss-offload on       (re)start ECM and force accel_mode=ACCEL
#   nss-offload off      PANIC ONLY: unload ECM. Loses all NSS offload
#                        (LAN and WAN); does NOT improve WAN TTL, because WAN
#                        was never accelerated. qmodem_ttl re-enables it on the
#                        next reload/reboot.

ECM_INIT=/etc/init.d/qca-nss-ecm
ACCEL=/sys/kernel/debug/ecm/ecm_classifier_default/accel_mode

on() {
	[ -x "$ECM_INIT" ] || { echo "qca-nss-ecm is not installed"; exit 1; }
	"$ECM_INIT" enable
	"$ECM_INIT" start
	# 0 = ECM_CLASSIFIER_ACCELERATION_MODE_ACCEL
	[ -e "$ACCEL" ] && echo 0 > "$ACCEL"
	echo "NSS/ECM ON - LAN/WiFi/bridge accelerated; modem egress stays on host (TTL rewrite applies)"
}

off() {
	[ -e "$ACCEL" ] && echo 1 > "$ACCEL"   # 1 = ECM_CLASSIFIER_ACCELERATION_MODE_NO
	if [ -x "$ECM_INIT" ]; then
		"$ECM_INIT" stop
		"$ECM_INIT" disable
	fi
	echo "NSS/ECM OFF (panic). WAN TTL is unchanged (it was never accelerated); LAN offload is lost until reboot/reload"
}

status() {
	if [ -d /sys/module/ecm ]; then
		echo "ECM loaded; accel_mode=$(cat "$ACCEL" 2>/dev/null) (0=accel 1=no 2=dont-care)"
	else
		echo "ECM NOT loaded - no NSS offload (LAN path is on the CPU)"
	fi
	if nft list chain inet fw4 byte_ttl >/dev/null 2>&1; then
		echo "TTL: byte_ttl chain loaded"
	else
		echo "TTL: byte_ttl chain NOT loaded"
	fi
	echo "Modem egress: excluded from acceleration by qca-nss-ecm patch 0027"
}

case "$1" in
on) on ;;
off) off ;;
status) status ;;
*)
	echo "usage: nss-offload on|off|status"
	exit 1
	;;
esac
