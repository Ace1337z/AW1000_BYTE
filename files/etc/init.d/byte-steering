#!/bin/sh /etc/rc.common
# BYTE by ACE - keep packet steering enabled across upgrades and reboots.
#
# Why this is a service and not (only) a uci-defaults script:
# sysupgrade without -n keeps /etc/config/network, so a unit flashed with
# <=1.2.30 still carries `option packet_steering '0'` and no steering_flows in
# its overlay. The one-shot 92-byte-steering cannot repair that on a later
# upgrade: it deletes itself after its first run, and the deletion is a whiteout
# in the preserved overlay, so the copy shipped in the next squashfs stays
# hidden. `99-enable-fxsd` has the same problem. A service that ships with its
# own S24 rc.d symlink runs on every boot regardless of what /etc kept.
#
# START=24 is deliberate: /etc/init.d/packet_steering is START=25 and reads
# these two keys exactly once, so the values must be final before it runs.
# qca-nss-ecm (START=26) no longer writes them - its feed init is patched in
# apply_preset() to re-apply the configured value instead.
#
# These are firmware tuning, not user preference: rps_sock_flow_entries is
# pinned to 32768 in /etc/sysctl.conf and byte-affinity sizes its RFS table to
# match. A steering_flows value larger than the global table is silently
# clamped, and disabling steering leaves both settings inert. So steering is
# never left at 0 by this service (see the repair policy below), while
# steering_flows is re-asserted to the size the rest of the image expects.
#
# packet_steering: 1 = one queue/NAPI thread per CPU, load-balanced (cache
# friendly with NSS/ath11k). 2 = every queue on all CPUs (helps only when the
# per-queue load is badly skewed, at the cost of cache locality).
#
# Repair policy: 0 and "unset" are the ECM regression and are set back to 1.
# A deliberate 2 ("Enabled (all CPUs)") is left alone - it is still steering.
# steering_flows is firmware sizing and is re-asserted.

START=24

STEERING=1
FLOWS=32768

start() {
	[ -f /etc/config/network ] || return 0

	sect=$(uci -q get network.@globals[0] >/dev/null 2>&1 && echo '@globals[0]')
	if [ -z "$sect" ]; then
		uci -q add network globals >/dev/null 2>&1 || return 0
		sect='@globals[0]'
	fi

	old_steer=$(uci -q get "network.$sect.packet_steering")
	old_flows=$(uci -q get "network.$sect.steering_flows")
	case "$old_steer" in
		0|'') new_steer=$STEERING ;;
		*) new_steer=$old_steer ;;
	esac

	changed=0
	if [ "$new_steer" != "$old_steer" ]; then
		uci -q set "network.$sect.packet_steering='$new_steer'" && changed=1
	fi
	if [ "$old_flows" != "$FLOWS" ]; then
		uci -q set "network.$sect.steering_flows='$FLOWS'" && changed=1
	fi
	[ "$changed" = 1 ] || return 0
	uci -q commit network || return 0

	logger -t byte-steering \
		"packet_steering ${old_steer:-unset} -> $new_steer, steering_flows ${old_flows:-unset} -> $FLOWS"
}
