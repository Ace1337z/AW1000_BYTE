#!/bin/sh /etc/rc.common
# Keeps the modem uplink interfaces present. qmodem deletes network.wan /
# network.wanv6 on every hang/redial (modem_dial.sh:flush_ip_cb) and only
# recreates them if the dial worker reaches set_if(). This service re-creates
# them within ~20s of any deletion so LuCI never shows a preset-less WAN.

START=95
STOP=15
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		while true; do
			/usr/libexec/qmodem-iface-heal 4_1
			sleep 20
		done'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
