#!/bin/sh /etc/rc.common
# BYTE by ACE - WAN egress queue sizing, from measurement.
#
# One instance, one loop, no timer-driven reload, no hotplug trigger: the only
# actor that touches `tc` on the modem interfaces. byte-affinity is deliberately
# not allowed near `tc` any more - 1.2.37 put a `tc qdisc replace` inside a
# function that ran on every interface event, which rebuilt the WAN queue every
# 2 s while the IPv6 watcher was up.
#
# See /usr/libexec/byte-fq-learn for the measurement and the two-stage bound.
START=97
STOP=11
USE_PROCD=1
TAG=byte-fq

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/byte-fq-learn
	# respawn on crash only; the helper never exits on its own. No stdout: the
	# helper reports through logger, and a spooled stdout would grow.
	procd_set_param respawn 3600 5 0
	procd_close_instance
}

stop_service() {
	for dev in /sys/class/net/wwan*; do
		[ -e "$dev" ] || continue
		tc qdisc replace dev "${dev##*/}" root fq 2>/dev/null
	done
	logger -t "$TAG" "stopped, qdisc returned to kernel default"
}
