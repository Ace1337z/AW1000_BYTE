#!/bin/sh /etc/rc.common
# BYTE by ACE - keep the vnStat database on persistent storage.
#
# vnStat's stock DatabaseDir is /var/lib/vnstat. /var is a tmpfs on OpenWrt,
# so every reboot threw away the whole traffic history - the dashboard showed
# "no data" after every power cycle and the on-demand vnStat page looked
# broken. /etc is on the overlay, which survives reboot, sysupgrade (with
# config kept) and factory-reset-with-keep-config.
#
# Re-asserted on every boot, not only at first boot: /etc/vnstat.conf is a
# conffile owned by the vnstat2 package, so a forced reinstall or an opkg
# upgrade can put the stock /var path back. The service then quietly moves the
# database again and restarts vnstatd, which also re-registers the interfaces
# listed in /etc/config/vnstat.
#
# Run order matters: START=55 lands after /etc/init.d/boot (uci-defaults) and
# after sysctl, but before vnstat's own START=60, so the first initdb already
# writes to the persistent path.
START=55
STOP=45
USE_PROCD=1
DBDIR=/etc/vnstat
CONF=/etc/vnstat.conf
LEGACY=/var/lib/vnstat

conf_ok() {
	grep -qE "^[[:space:]]*DatabaseDir[[:space:]]+\"$DBDIR\"[[:space:]]*$" "$CONF" 2>/dev/null
}

set_conf() {
	[ -f "$CONF" ] || return 0
	conf_ok && return 0
	# Rewrite the active or commented-out default, else append it.
	if grep -qE '^[[:space:]]*;?[[:space:]]*DatabaseDir[[:space:]]' "$CONF"; then
		sed -i -E "s#^[[:space:]]*;?[[:space:]]*DatabaseDir[[:space:]]+.*#DatabaseDir \"$DBDIR\"#" "$CONF"
	else
		printf '%s\n' "DatabaseDir \"$DBDIR\"" >>"$CONF"
	fi
	conf_ok || logger -t byte-vnstat-db "could not set DatabaseDir in $CONF"
}

migrate() {
	local f
	[ -d "$LEGACY" ] || return 0
	for f in "$LEGACY"/*; do
		[ -f "$f" ] || continue
		[ -e "$DBDIR/${f##*/}" ] && continue
		mv "$f" "$DBDIR/" 2>/dev/null &&
			logger -t byte-vnstat-db "migrated ${f##*/} from tmpfs"
	done
}

start_service() {
	mkdir -p "$DBDIR" || {
		logger -t byte-vnstat-db "$DBDIR not creatable, history stays in tmpfs"
		return 0
	}
	chmod 755 "$DBDIR"
	# Writes are rare (vnstatd flushes every 5 min per interface) but they now
	# land on flash instead of RAM. Say so once at boot rather than silently.
	logger -t byte-vnstat-db "database in $DBDIR (persistent)"
	set_conf
	migrate
	# Only restart when something actually changed, so a plain reboot does not
	# interrupt the daemon the init scripts are about to start anyway.
	if [ -x /etc/init.d/vnstat ] && /etc/init.d/vnstat enabled >/dev/null 2>&1; then
		/etc/init.d/vnstat restart >/dev/null 2>&1
	fi
	procd_open_instance
	procd_set_param command /bin/true
	procd_close_instance
}
