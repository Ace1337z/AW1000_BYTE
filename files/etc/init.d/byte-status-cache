#!/bin/sh /etc/rc.common
# BYTE by ACE - writes /tmp/aw1000-status/* for the dashboard widgets.
#
# Starts late: the modem has to be enumerated before the first AT poll is
# useful, and qmodem's at-daemon must already own the port. The loop tolerates
# both being absent (thermal data is still written).
START=98
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/byte-status-cache
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
