#!/bin/sh /etc/rc.common
# BYTE by ACE - verify the tuning described in sysctl.conf / cpufreq /
# byte-affinity / byte-mtu actually took effect on this unit.
#
# Every value below is *declared* elsewhere in the image. Until now nothing
# checked that the kernel accepted it, and a rejected key is silent: sysctl -p
# aborts the remainder of the file on the first error, a governor may not exist
# for this CPU, and qmodem recreates wwan0 on every redial. This logs the
# observed value next to the expected one and reports a single summary line, so
# "is tuning applied?" is a log question instead of an SSH session.
#
# Runs late (S99) so wwan0 exists after the modem dials, and again on every
# interface up (see /etc/hotplug.d/iface/91-byte-selfcheck).

START=99
STOP=01

TAG=byte-selfcheck
MTU_WANT=1420
GOV_WANT=performance

# RPS mask covering every CPU, derived rather than hardcoded: this box has 4
# cores (mask f) but the same image logic must not silently assert "0f" on a
# different core count. printf %x keeps it in the same form the kernel prints
# (no leading zeros), which is what the comparison below normalises anyway.
_ncpu=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
[ "$_ncpu" -ge 1 ] 2>/dev/null || _ncpu=1
CPUMASK=$(printf '%x' $(( (1 << _ncpu) - 1 )))
unset _ncpu

fails=0
oks=0

# report <label> <expected> <actual>; expected & actual are compared literally.
# An empty actual means the source is missing (e.g. wwan0 not up yet), which is
# reported as skip rather than a failure.
report() {
	local label="$1" want="$2" got="$3"
	if [ -z "$got" ]; then
		logger -t "$TAG" "$label: SKIP (unavailable)"
		return
	fi
	if [ "$want" = "$got" ]; then
		oks=$((oks + 1))
		logger -t "$TAG" "$label: OK $got"
	else
		fails=$((fails + 1))
		logger -t "$TAG" "$label: MISMATCH want=$want got=$got"
	fi
}

check_cpu() {
	local c dev gov min max
	for c in /sys/devices/system/cpu/cpu[0-9]*/cpufreq; do
		[ -d "$c" ] || continue
		dev=${c#/sys/devices/system/cpu/}
		gov=$(cat "$c/scaling_governor" 2>/dev/null)
		report "cpu.$dev.governor" "$GOV_WANT" "$gov"
		[ "$gov" = "$GOV_WANT" ] || continue
		# min == max proves the frequency is pinned, not merely governed.
		min=$(cat "$c/scaling_min_freq" 2>/dev/null)
		max=$(cat "$c/scaling_max_freq" 2>/dev/null)
		report "cpu.$dev.min_eq_max" "$max" "$min"
	done
}

check_sysctl() {
	# The expected value is the one declared in files/etc/sysctl.conf.
	report qdisc.fq fq "$(cat /proc/sys/net/core/default_qdisc 2>/dev/null)"
	report cc.bbr bbr "$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)"
	report mtu_probing 1 "$(cat /proc/sys/net/ipv4/tcp_mtu_probing 2>/dev/null)"
	report slow_start_idle 0 "$(cat /proc/sys/net/ipv4/tcp_slow_start_after_idle 2>/dev/null)"
	report netdev_budget 2400 "$(cat /proc/sys/net/core/netdev_budget 2>/dev/null)"
	report netdev_max_backlog 16384 "$(cat /proc/sys/net/core/netdev_max_backlog 2>/dev/null)"
	report rps_sock_flow_entries 32768 "$(cat /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null)"
	report fastopen 3 "$(cat /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null)"
	report notsent_lowat 131072 "$(cat /proc/sys/net/ipv4/tcp_notsent_lowat 2>/dev/null)"
	report conntrack_max 32768 "$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"
	report keepalive_time 120 "$(cat /proc/sys/net/ipv4/tcp_keepalive_time 2>/dev/null)"
	report no_metrics_save 1 "$(cat /proc/sys/net/ipv4/tcp_no_metrics_save 2>/dev/null)"
	report syn_retries 3 "$(cat /proc/sys/net/ipv4/tcp_syn_retries 2>/dev/null)"
	report synack_retries 3 "$(cat /proc/sys/net/ipv4/tcp_synack_retries 2>/dev/null)"
	report retries2 8 "$(cat /proc/sys/net/ipv4/tcp_retries2 2>/dev/null)"
	report rmem_max 4194304 "$(cat /proc/sys/net/core/rmem_max 2>/dev/null)"
	# BBR only exists if CONFIG_TCP_CONG_BBR was compiled in; fq likewise.
	[ "$(cat /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null | grep -cw bbr)" -eq 1 ] \
		|| { logger -t "$TAG" "bbr.module: SKIP (not compiled in)"; }
}

check_iface() {
	local dev cur qq
	for dev in wwan0 wwan0_1; do
		ip link show "$dev" >/dev/null 2>&1 || continue
		cur=$(ip link show "$dev" 2>/dev/null | grep -oE 'mtu [0-9]+' | cut -d' ' -f2)
		report "iface.$dev.mtu" "$MTU_WANT" "$cur"
		qq=$(tc qdisc show dev "$dev" 2>/dev/null | awk '{print $2; exit}')
		report "iface.$dev.qdisc" fq "$qq"
		case "$qq" in
			fq) ;;
			*) logger -t "$TAG" "iface.$dev.qdisc: note - BBR pacing wants fq, got ${qq:-none}" ;;
		esac

		# RPS must cover every core; one core is the single-core ceiling
		# that byte-affinity exists to remove. The kernel prints the mask
		# WITHOUT leading zeros ("f", not "0f") and the width grows with the
		# core count, so compare numerically against the CPU bitmap rather
		# than string-matching a literal mask.
		local q mask
		for q in /sys/class/net/"$dev"/queues/rx-*/rps_cpus; do
			[ -e "$q" ] || continue
			mask=$(cat "$q" 2>/dev/null)
			if [ -z "$mask" ]; then
				report "rps.$dev.$(basename "$(dirname "$q")")" "$CPUMASK" ""
			elif [ $((0x$mask)) -eq $((0x$CPUMASK)) ]; then
				report "rps.$dev.$(basename "$(dirname "$q")")" "$CPUMASK" "$CPUMASK"
			else
				report "rps.$dev.$(basename "$(dirname "$q")")" "$CPUMASK" "$mask"
			fi
		done

		# RFS flow table must be populated or rps_flow_cnt is inert.
		for q in /sys/class/net/"$dev"/queues/rx-*/rps_flow_cnt; do
			[ -e "$q" ] || continue
			report "rfs_flow_cnt.$dev.$(basename "$(dirname "$q")")" \
				"$(cat /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null)" \
				"$(cat "$q" 2>/dev/null)"
		done
		# Software IRQ coalescing on the modem netdev. Without it every packet
		# takes a hard IRQ on the one core the xhci interrupt cannot leave;
		# 20000 ns is the upstream default netdev_sw_irq_coalesce_default_on()
		# uses, so this is latency-neutral and only cuts interrupt count.
		report "napi.$dev.defer" 2 \
			"$(cat /sys/class/net/"$dev"/napi_defer_hard_irqs 2>/dev/null)"
		report "napi.$dev.gro_flush_ns" 20000 \
			"$(cat /sys/class/net/"$dev"/gro_flush_timeout 2>/dev/null)"
	done
}

check_zram() {
	local swapsz
	swapsz=$(awk '/\/dev\/zram/{print $3}' /proc/swaps 2>/dev/null)
	# Reported in KB by /proc/swaps; 433 MB is roughly 443392 KB. Only assert
	# that some zram swap is live - the exact size is a config, not a behaviour.
	if [ -n "$swapsz" ]; then
		report zram.swap live live
	else
		report zram.swap live ""
	fi
}

# Packet steering runs from netifd at START=25 and writes rps_cpus/flow_cnt on
# the ethernet queues plus the UCI switch. Both are checked: the switch alone
# proves nothing if the script found no queue to steer (single-queue drivers).
# vnStat's database path is checked here too - it must not point into tmpfs.
check_steering() {
	local want got steered=0 q db
	want=$(uci -q get network.@globals[0].packet_steering)
	report steering.enabled 1 "$want"
	report steering.flows 32768 "$(uci -q get network.@globals[0].steering_flows)"
	for q in /sys/class/net/*/queues/rx-*/rps_cpus; do
		[ -r "$q" ] || continue
		got=$(cat "$q" 2>/dev/null)
		[ -n "$got" ] && [ "$got" != "0" ] && steered=$((steered + 1))
	done
	if [ "$steered" -ge 2 ]; then
		report steering.queues steered steered
	else
		report steering.queues steered "none($steered)"
	fi
	db=$(sed -n 's/^[[:space:]]*DatabaseDir[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1/p' \
		/etc/vnstat.conf 2>/dev/null | head -1)
	report vnstat.databasedir /etc/vnstat "$db"
	[ -d /etc/vnstat ] && report vnstat.dir present present
}
# The fw4 flowtable must stay OFF in both TTL states, and the include must be
# the file this build writes. Policy: flow_offloading=0 whether the TTL switch
# is on or off - the flowtable skips the mangle chain after the first packet,
# so an enabled flowtable leaks the sender's TTL on Windows hosts (128) for
# the life of the flow.
# The chain itself is only logged (not asserted): this runs from a hotplug
# iface event and can fire before qmodem_ttl (START=95) has loaded the include.
check_ttl() {
	local en ttl
	# Before qmodem_ttl (START=95) has run, the offload state is still the
	# shipped default - asserting here would produce a false MISMATCH on an
	# early hotplug iface event.
	/etc/init.d/qmodem_ttl running >/dev/null 2>&1 || {
		logger -t "$TAG" "ttl: SKIP (qmodem_ttl not started yet)"
		return
	}
	en=$(uci -q get qmodem_ttl.main.enable)
	[ -n "$en" ] || en=1
	ttl=$(uci -q get qmodem_ttl.main.ttl)
	[ -n "$ttl" ] || ttl=64
	if [ "$en" = "1" ]; then
		case "$ttl" in '' | *[!0-9]*) ttl=0 ;; esac
		if [ "$ttl" -ge 1 ] 2>/dev/null && [ "$ttl" -le 255 ] 2>/dev/null; then
			report ttl.value in-1-255 in-1-255
		else
			report ttl.value in-1-255 "out-of-range($ttl)"
		fi
	fi
	# Same expectation in both branches: the flowtable is never wanted.
	report ttl.flow_offloading 0 "$(uci -q get firewall.@defaults[0].flow_offloading)"
	report ttl.flow_offloading_hw 0 "$(uci -q get firewall.@defaults[0].flow_offloading_hw)"
	if [ -r /etc/nftables.d/90-byte-ttl.nft ]; then
		logger -t "$TAG" "ttl.include: present (chain $(nft list chain inet fw4 byte_ttl >/dev/null 2>&1 && echo loaded || echo NOT-loaded))"
	fi
}

# NSS/ECM must be loaded and accelerating, and it must never accelerate modem
# egress: the TTL rewrite is a netfilter rule and an accelerated flow bypasses
# netfilter. qca-nss-ecm patch 0027 registers wwan*/rmnet* as UNKNOWN with an
# invalid accelerator ifnum, so the rule create is rejected and those flows
# stay on the host path.
#
# The interface table is dumped through ECM's state char device. Its major is
# exported in debugfs; the device node is not created by the image. Output mask
# 16 selects ECM_STATE_FILE_OUTPUT_INTERFACES (512, the *_CHAIN variant, only
# prints hash-chain lengths), and is restored to CONNECTIONS (1) afterwards.
ECM_STATE_MASK=/sys/kernel/debug/ecm/ecm_state/state_file_output_mask
ECM_ACCEL=/sys/kernel/debug/ecm/ecm_classifier_default/accel_mode

ecm_state_dump() {
	local maj node=/tmp/.ecm_state_dev
	maj=$(cat /sys/kernel/debug/ecm/ecm_state/state_dev_major 2>/dev/null)
	[ -n "$maj" ] || return 1
	[ -w "$ECM_STATE_MASK" ] || return 1
	# 16 = ECM_STATE_FILE_OUTPUT_INTERFACES: every interface instance with its
	# name and ae_interface_identifier. 512 would be INTERFACES_CHAIN, which
	# only prints per-hash-chain lengths, not the interfaces themselves.
	echo 16 >"$ECM_STATE_MASK" 2>/dev/null || return 1
	rm -f "$node"
	mknod "$node" c "$maj" 0 2>/dev/null || {
		echo 1 >"$ECM_STATE_MASK" 2>/dev/null
		return 1
	}
	cat "$node" 2>/dev/null
	rm -f "$node"
	# Restore the default: 1 = ECM_STATE_FILE_OUTPUT_CONNECTIONS.
	echo 1 >"$ECM_STATE_MASK" 2>/dev/null
}

check_nss() {
	local mode dump=/tmp/.ecm_iface_state leak
	if [ ! -d /sys/module/ecm ]; then
		logger -t "$TAG" "nss.ecm: SKIP (not loaded)"
		return
	fi
	report nss.ecm loaded loaded
	mode=$(cat "$ECM_ACCEL" 2>/dev/null)
	report nss.accel_mode 0 "$mode"
	if ! ecm_state_dump >"$dump" 2>/dev/null; then
		logger -t "$TAG" "nss.modem_excluded: SKIP (ECM state device unavailable)"
		rm -f "$dump"
		return
	fi
	# Lines look like
	#   ifaces.iface.<subtype>.iface.name=wwan0
	#   ifaces.iface.<subtype>.iface.ae_interface_identifier=-1
	# in that order, so the name is known when the id is read. The subtype
	# segment is not fixed (ethernet/bridge/pppoe/unknown/...), so match on the
	# leaf key only; with mask 16 nothing but ifaces is in the dump.
	leak=$(awk -F= '
		/\.name=/ { n = $2 }
		/\.ae_interface_identifier=/ {
			a = $2 + 0
			if (n ~ /^(wwan|rmnet)/ && a >= 0) print n " ae=" a
		}' "$dump" | head -5)
	rm -f "$dump"
	if [ -n "$leak" ]; then
		logger -t "$TAG" "ECM_MODEM_LEAK: modem iface has an accelerator id: $leak"
		logger -t "$TAG" "stopping ECM: TTL rewrite must stay authoritative"
		/etc/init.d/qca-nss-ecm stop 2>/dev/null
		fails=$((fails + 1))
	else
		oks=$((oks + 1))
		logger -t "$TAG" "nss.modem_excluded: OK (no wwan/rmnet iface accelerated)"
	fi
}

start() {
	logger -t "$TAG" "begin (mtu=$MTU_WANT governor=$GOV_WANT cpumask=$CPUMASK)"
	check_cpu
	check_sysctl
	check_iface
	check_zram
	check_steering
	check_ttl
	check_nss
	if [ "$fails" -eq 0 ]; then
		logger -t "$TAG" "PASS ${oks} checks, 0 mismatches"
	else
		logger -t "$TAG" "FAIL ${fails} mismatches, ${oks} ok"
	fi
}
