config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fdb0:d40a:1782::/48'
	# Packet steering: netifd's packet_steering (START=25) pins each netdev's
	# NAPI threads and RX queues to CPUs so that one core does not take every
	# interrupt while the other three idle. "1" = one CPU per queue/NAPI
	# thread, spread by load; "2" would put every queue on all CPUs, which
	# avoids the per-queue bottleneck but loses the cache locality that makes
	# NSS/WiFi forwarding cheap. The modem's own xhci IRQ is not movable (the
	# kernel collapses its affinity back to one CPU), so byte-affinity keeps
	# steering the *processing* of wwan traffic with RPS on top of this.
	# steering_flows must match net.core.rps_sock_flow_entries (set to 32768
	# in sysctl.conf, and re-asserted by byte-affinity) or RFS tracking is
	# silently clamped.
	option packet_steering '1'
	option steering_flows '32768'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'lan3'
	list ports 'lan4'
	list ports 'wan'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.1.1'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option defaultroute '0'

config interface 'wan'
	option device 'wwan0_1'
	option proto 'dhcp'
	option modem_config '4_1'
	option defaultroute '1'
	option metric '11'

config interface 'wanv6'
	option modem_config '4_1'
	option proto 'dhcpv6'
	option ifname '@wan'
	option device '@wan'
	option metric '11'
	option extendprefix '1'
