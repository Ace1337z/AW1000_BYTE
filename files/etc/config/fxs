config fxs 'main'
	option enabled '1'
	option channel '1'
	option tx_gain '-6'
	option rx_gain '0'
	# "auto" lets fxsd pick the port that answers instead of pinning ttyUSB2:
	# the RG500Q's ports renumber after a modem reset, and a pinned number is
	# then either dead or (worse) the QMI data port.
	option at_port 'auto'
	option volume '5'
	option modem_rx_gain '8192'
	option patch '/etc/fxs/si3226x_patch.bin'
	option led 'green:phone'
	option led_ready 'on'
	option led_ringing 'fast'
	option led_offhook 'slow'
	option ringback '1'
	# 0.7.0 additions. All off/default: HD needs a phone that negotiates G.722
	# and SIP needs QModem voice, so neither is enabled blind on an open image.
	option hd '0'
	option sip '0'
	option callerid 'bellcore'
	option callerid_timing 'after'
	option ring_pattern 'standard'
	option history_autodelete '0'
	option history_days '30'
