
config system
	option hostname 'BYTE_by_ACE'
	option timezone '<+08>-8'
	option ttylogin '0'
	option log_size '128'
	option urandom_seed '0'
	option zonename 'Asia/Kuala Lumpur'
	option log_proto 'udp'
	option conloglevel '8'
	option cronloglevel '7'
	# lzo-rle is the only algorithm this kernel ships (CONFIG_CRYPTO_LZ4 is
	# off, and no *lz4* module exists in /lib/modules). With 'lz4' configured,
	# zram-swap logs "compression algorithm 'lz4' is not supported" and gives
	# up - silently, because the init script still exits 0. The result was a
	# 433 MB zram device allocated but only 0 kB of swap on a running router.
	option zram_comp_algo 'lzo-rle'
	option zram_size_mb '433'

config timeserver 'ntp'
	list server 'ntp.tencent.com'
	list server 'ntp1.aliyun.com'
	list server 'ntp.ntsc.ac.cn'
	list server 'cn.ntp.org.cn'

config imm_init
	option lang '1'
	option system_chn '1'
	option opkg_mirror 'https://mirrors.vsean.net/openwrt'
	option anon_mount '1'

config led
	option name '5G'
	option sysfs 'blue:5g'
	option trigger 'default-on'

config led
	option name 'SIGNAL'
	option sysfs 'blue:signal'
	option trigger 'default-on'

config led
	option name 'WIFI'
	option sysfs 'green:wifi'
	option trigger 'default-on'

config led
	option name 'INTERNET'
	option sysfs 'green:internet'
	option trigger 'netdev'
	option dev 'br-lan'
	list mode 'tx'
	list mode 'rx'

config led
	option name 'PHONE'
	option sysfs 'green:phone'
	option trigger 'none'

