config main 'main'
	# TTL / Hop Limit rewriting on modem egress, owned by
	# luci-app-qmodem-ttlfw4 (LuCI: Network -> Modem -> TTL Configuration).
	#
	# The rewrite is ALWAYS installed by default. NSS/ECM is always running
	# too: modem data interfaces (wwan*, rmnet*) are excluded from acceleration
	# inside ECM itself (qca-nss-ecm patch 0027), so WAN packets always reach
	# this netfilter rule while bridge/LAN/WiFi traffic stays accelerated.
	#
	# enable 1 -> nft chain byte_ttl rewrites IPv4 TTL and IPv6 Hop Limit on
	#             every packet leaving through the modem, including
	#             router-originated traffic. NSS stays on.
	# enable 0 -> the include is removed; TTL passes through unchanged. NSS
	#             still stays on. fw4's flow_offloading is forced to 0 in both
	#             states because the software flowtable bypasses this chain.
	#
	# ttl is a single value for both IPv4 TTL and IPv6 Hop Limit, range 1-255.
	# 64 matches a Linux host; 128 matches Windows. Any value the carrier
	# expects can be typed here or in LuCI.
	option enable '1'
	option ttl '64'
