# BYTE by ACE - local tuning knobs read by /etc/init.d/byte-affinity.
#
# This file exists so the WAN queue can be bounded without reflashing. Every
# value is optional: a missing file, a missing section or a non-numeric value
# falls back to the built-in default, which is the value this image was tested
# with.

config fq 'wwan'
	# 1 = apply a bounded fq to the modem interfaces, 0 = plain fq with kernel
	# defaults. 0 keeps BBR pacing but restores the 10000-packet queue.
	option enabled '1'

	# Upload rate of the bearer in kbit/s. This is the number the queue limit
	# is sized from, so it should be the real uplink, not the downlink and not
	# the radio's theoretical peak. 0 means "ask /sys/class/net/<dev>/speed and
	# fall back to 200000 when it reports nothing useful".
	option uplink_kbit '200000'

	# Worst-case RTT of the bearer in ms. 5G NSA is typically 30-50 ms.
	option rtt_ms '40'

	# Packets a single flow may queue. This is the latency knob: 100 packets
	# of 1500 B is 150 KB, which is under 15 ms at 100 Mbit/s and under 7 ms
	# at 200 Mbit/s. Lower = lower latency for that flow, at the cost of
	# throughput on a high-BDP bearer.
	option flow_limit '100'

	# Slow-start burst per flow in bytes. The fq default is 15140 (10 packets),
	# which throttles the first RTT of every new flow on a 40 ms bearer.
	option initial_quantum '65536'
