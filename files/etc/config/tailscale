# Tailscale configuration shipped with BYTE by ACE.
#
# fw_mode=nftables is the important one: this image is firewall4/nftables only
# and ships no xtables at all, so the default iptables mode cannot work.
config tailscale 'settings'
	option log_stderr '1'
	option log_stdout '1'
	option port '41641'
	option state_file '/etc/tailscale/tailscaled.state'
	option fw_mode 'nftables'
	option accept_routes '0'
	option advertise_exit_node '0'
	option exit_node_allow_lan_access '0'
	# Set to 1 to expose the web client on the Tailscale IP only.
	option runwebclient '0'
	option nosnat '0'
	option ssh '0'
	option disable_magic_dns '0'