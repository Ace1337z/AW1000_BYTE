# AW1000 RJ11 phone port bring-up (runs every boot, background).
# - clear a stale fxsd "previous start did not finish" guard from a reboot
# - force the modem PCM to slave mode (AT+QDAI 2nd field = 1) so call audio
#   works; restart the modem once when it was master
# - start fxsd now that the SLIC patch is present
# - make sure the WAN uplink self-heal service is running (uci-defaults only
#   runs on a factory-fresh config, so a sysupgrade that keeps /etc/config
#   would otherwise never enable it)
if [ -x /etc/init.d/qmodem-iface-heal ]; then
	/etc/init.d/qmodem-iface-heal enable 2>/dev/null
	/etc/init.d/qmodem-iface-heal running >/dev/null 2>&1 || \
		/etc/init.d/qmodem-iface-heal start 2>/dev/null
fi

# TTL 64 on modem egress must be active on every boot, including after a
# sysupgrade that preserved /etc/config (uci-defaults only runs once).
# ECM is stopped first: it bypasses netfilter and would leak the real TTL.
if [ -x /etc/init.d/qca-nss-ecm ]; then
	/etc/init.d/qca-nss-ecm enabled >/dev/null 2>&1 && {
		/etc/init.d/qca-nss-ecm disable 2>/dev/null
	}
fi
if [ -x /etc/init.d/byte-ttl ]; then
	/etc/init.d/byte-ttl enable 2>/dev/null
	/etc/init.d/byte-ttl running >/dev/null 2>&1 || \
		/etc/init.d/byte-ttl start 2>/dev/null
fi

# RPS/XPS across all cores for the modem interfaces; also re-runs on netifd
# events because wwan0_1 only appears once qmodem dials.
if [ -x /etc/init.d/byte-affinity ]; then
	/etc/init.d/byte-affinity enable 2>/dev/null
	/etc/init.d/byte-affinity running >/dev/null 2>&1 || \
		/etc/init.d/byte-affinity start 2>/dev/null
fi

(
	ATPORT="/dev/ttyUSB3"
	QDAI_SLAVE="AT+QDAI=x,1,0,4,0,0,1,1"

	# Stale guard left by a reboot keeps fxsd from starting; clear it.
	if [ -x /etc/init.d/fxsd ]; then
		/etc/init.d/fxsd clear_guard 2>/dev/null
	fi

	# The PCM check below deliberately uses sms_tool directly rather than
	# going through ubus at-daemon: it must work even if the daemon is slow
	# to come up, and sms_tool needs no service.
	at_q() {
		command -v sms_tool >/dev/null 2>&1 || return 1
		timeout 6 sms_tool -d "$ATPORT" at "$1" 2>/dev/null | tr -d '\r'
	}

	# Wait for the modem's AT port to answer before touching PCM.
	# sms_tool's output for a bare "AT" is only the command echo - it does
	# not include OK on this modem - so probe with a command that has a real
	# response and test for that instead.
	i=0
	while [ "$i" -lt 60 ]; do
		if [ -c "$ATPORT" ] && at_q "AT+QDAI?" | grep -q '+QDAI:'; then
			break
		fi
		sleep 2
		i=$((i+1))
	done

	resp=$(at_q "AT+QDAI?")
	field2=$(printf '%s' "$resp" | grep -oE '\+QDAI: [^,]+,[^,]+' | cut -d, -f2)
	case "$field2" in
		1)
			logger -t fxsd "modem PCM already in slave mode"
			;;
		0)
			logger -t fxsd "modem PCM is master; setting slave + restarting modem"
			at_q "$QDAI_SLAVE" >/dev/null
			sleep 8
			at_q "$QDAI_SLAVE" >/dev/null
			at_q "AT+CFUN=1,1" >/dev/null
			;;
		*)
			logger -t fxsd "could not read AT+QDAI; skipping PCM setup"
			;;
	esac

	# fxsd drives the phone, but it sends every AT command through
	# 'ubus call at-daemon sendat'. Without that ubus object it loops forever
	# in wait_modem() and the phone sits at "Waiting for the modem", even
	# though the modem is perfectly reachable via sms_tool. So make sure the
	# daemon is actually answering before fxsd is started; fxsd would retry
	# every 3s anyway, but waiting here avoids a pointless log churn and the
	# case where procd marks the service failed.
	if [ -x /etc/init.d/ubus-at-daemon ]; then
		/etc/init.d/ubus-at-daemon start 2>/dev/null
		i=0
		while [ "$i" -lt 20 ]; do
			ubus list 2>/dev/null | grep -qx 'at-daemon' && break
			sleep 1
			i=$((i+1))
		done
		ubus list 2>/dev/null | grep -qx 'at-daemon' ||
			logger -t fxsd "ubus at-daemon did not register; the phone will stay at 'waiting for modem'"
	fi

	# Start fxsd once the patch is present and PCM is (attempted) slave.
	if [ -x /etc/init.d/fxsd ] && [ -s /etc/fxs/si3226x_patch.bin ]; then
		/etc/init.d/fxsd start 2>/dev/null
	fi
	logger -t fxsd "phone bring-up done"
) &

# Tailscale self-heal. tailscaled sometimes comes up "Running" and reports its
# Tailscale IP, yet tailscale0 is left with no IPv4/IPv6 address at all. The
# result is a node that looks connected but is unreachable: MagicDNS at
# 100.100.100.100 times out and no peer can be dialled. Waiting for the address
# and restarting the daemon if it never lands fixes it without a reboot.
(
	[ -x /usr/sbin/tailscaled ] || exit 0
	ts_ip=$(/usr/sbin/tailscale ip -4 2>/dev/null | head -1)
	[ -n "$ts_ip" ] || exit 0

	i=0
	while [ "$i" -lt 30 ]; do
		ip -4 addr show tailscale0 2>/dev/null | grep -q "inet ${ts_ip}" && break
		sleep 2
		i=$((i + 1))
	done

	if ip -4 addr show tailscale0 2>/dev/null | grep -q "inet ${ts_ip}"; then
		logger -t byte-ts "tailscale0 ready (${ts_ip})"
	else
		logger -t byte-ts "tailscale0 never got ${ts_ip}; restarting tailscaled"
		/etc/init.d/tailscale restart >/dev/null 2>&1
		sleep 10
		ip -4 addr show tailscale0 2>/dev/null | grep -q "inet ${ts_ip}" &&
			logger -t byte-ts "tailscale0 recovered (${ts_ip})" ||
			logger -t byte-ts "tailscale0 still has no address; check 'tailscale status'"
	fi
) &

exit 0