#!/bin/sh
# BYTE by ACE - re-judge IPv6 as soon as an uplink changes.
#
# The watcher in /usr/libexec/byte-v6-check sleeps 300s while IPv6 is healthy
# and 30s while it is demoted. A modem redial can hand us a working (or a
# freshly broken) IPv6 bearer at any moment, so waiting for the next tick would
# leave the LAN on the wrong family for minutes. This only pokes the watcher;
# the measurement and any uci change stay in one place.
[ -x /usr/libexec/byte-v6-check ] || exit 0

# Any interface event may change the answer (a VPN could add IPv6, the modem
# redial changes the uplink), and the kick is a single file touch - so do not
# bother filtering on name.
case "$ACTION" in
	ifup|ifdown|ifupdate)
		/usr/libexec/byte-v6-check --kick
		;;
esac
