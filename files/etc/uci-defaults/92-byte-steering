#!/bin/sh
# BYTE by ACE - first boot / upgrade: re-assert packet steering.
#
# Why this exists: images up to 1.2.0 shipped `packet_steering '0'` in
# /etc/config/network. 1.2.1 changed it to '1', but sysupgrade without `-n`
# keeps the old /etc/config/network, so an upgraded unit still showed
# "Packet Steering: Disabled" in Network -> Interfaces -> Global network
# options and byte-selfcheck logged `steering.enabled 1 0` (MISMATCH) forever.
# Nothing was wrong with netifd: the service runs at START=25 and reads
# network.@globals[0].packet_steering, it was simply told to stay off.
#
# These two values are firmware tuning, not user preference: the performance
# tuning in sysctl.conf (rps_sock_flow_entries=32768) and byte-affinity only
# make sense with steering on, and steering_flows must match or RFS is clamped.
# They are therefore set outright here, once - this script then deletes itself,
# so a later manual change is not fought on every boot.

[ -f /etc/config/network ] || exit 0

# The globals section may be anonymous; create it if this image has none.
sect=$(uci -q get network.@globals[0] >/dev/null 2>&1 && echo '@globals[0]')
if [ -z "$sect" ]; then
	uci -q add network globals >/dev/null 2>&1 || exit 0
	sect='@globals[0]'
fi

old_steer=$(uci -q get "network.$sect.packet_steering")
old_flows=$(uci -q get "network.$sect.steering_flows")

uci -q set "network.$sect.packet_steering='1'"
uci -q set "network.$sect.steering_flows='32768'"
uci -q commit network

# Apply now, without waiting for the next boot: the service reloads its
# triggers on `network` changes and rewrites rps_cpus / rps_flow_cnt.
if [ "$old_steer" != "1" ] || [ "$old_flows" != "32768" ]; then
	logger -t byte-steering \
		"packet_steering $old_steer -> 1, steering_flows $old_flows -> 32768"
	/etc/init.d/packet_steering restart >/dev/null 2>&1 || true
fi

exit 0
