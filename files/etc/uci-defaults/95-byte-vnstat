#!/bin/sh
# BYTE by ACE - first boot: vnStat history on persistent storage.
#
# byte-vnstat-db repoints /etc/vnstat.conf at /etc/vnstat (the overlay) and
# moves any database it finds in /var/lib/vnstat, so history survives reboots.
# Enable it here; it also re-asserts the path on every later boot in case an
# opkg upgrade restores the packaged conffile.
if [ -x /etc/init.d/byte-vnstat-db ]; then
	/etc/init.d/byte-vnstat-db enable 2>/dev/null
	/etc/init.d/byte-vnstat-db start 2>/dev/null
fi
# vnStat itself must collect from boot or the graph has holes after a reboot.
if [ -x /etc/init.d/vnstat ]; then
	/etc/init.d/vnstat enable 2>/dev/null
fi
exit 0
