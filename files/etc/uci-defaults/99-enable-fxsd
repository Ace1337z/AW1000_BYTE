#!/bin/sh
# Enable the AW1000 RJ11 phone port on first boot.
#
# 1) Set the modem PCM interface to slave mode (fxsd's wait_modem() blocks until
#    AT+QDAI reports slave). Retry for up to ~120s for the modem to come up.
# 2) Enable + start fxsd now that /etc/fxs/si3226x_patch.bin is shipped.

ATPORT="/dev/ttyUSB2"
QDAI="AT+QDAI=x,1,0,4,0,0,1,1"

i=0
until [ "$i" -ge 40 ]; do
	if [ -e "$ATPORT" ] && \
	   ubus call at-daemon sendat "{\"at_port\":\"$ATPORT\",\"at_cmd\":\"AT+QDAI?\",\"timeout\":2}" 2>/dev/null | grep -qi "0,4,0,0,1,1"; then
		break
	fi
	i=$((i+1))
	sleep 3
done
# Set it to slave regardless (idempotent); ignore failure if modem still down.
ubus call at-daemon sendat "{\"at_port\":\"$ATPORT\",\"at_cmd\":\"$QDAI\",\"timeout\":3}" >/dev/null 2>&1

if [ -x /etc/init.d/fxsd ] && [ -s /etc/fxs/si3226x_patch.bin ]; then
	/etc/init.d/fxsd enable 2>/dev/null
	/etc/init.d/fxsd start 2>/dev/null
fi

exit 0