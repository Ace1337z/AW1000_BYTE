#!/bin/sh
# Bring up the AW1000 RJ11 phone port on FIRST boot only.
#
# fxsd needs:
#   - /etc/fxs/si3226x_patch.bin (shipped) present, and
#   - the modem PCM interface in slave mode (AT+QDAI 2nd field = 1), else
#     fxsd's wait_modem() blocks forever and the phone won't work, and
#   - the 'at-daemon' ubus object: fxsd sends every AT command through
#     'ubus call at-daemon sendat', so without ubus-at-daemon running the
#     phone sits at "Waiting for the modem" even though the modem answers
#     sms_tool fine. That is why ubus-at-daemon is a shipped dependency.
#
# The per-boot heavy lifting (PCM check, stale-guard clear, daemon + fxsd
# start) runs from /etc/rc.local in the background every boot. Here we only
# mark the services enabled and re-assert the wan default route on first boot.

echo "[fxsd] first-boot: enabling fxsd (phone port)"
if [ -x /etc/init.d/fxsd ]; then
	/etc/init.d/fxsd enable 2>/dev/null
fi

# Point opkg at both the kmod repo and the ImmortalWrt 24.10.6 opkg feeds.
# Runs after base-files has written its own distfeeds.conf, so this wins.
if [ -x /usr/sbin/byte-opkg-feeds ]; then
	/usr/sbin/byte-opkg-feeds 2>/dev/null
	rm -rf /var/opkg-lists
fi

# Tailscale: enable at boot so the router is reachable over the tailnet after a
# reboot. rc.local additionally waits for tailscale0 to receive its address and
# restarts tailscaled if it never does - the daemon can report "Running" while
# the interface is left empty, which makes MagicDNS time out.
if [ -x /etc/init.d/tailscale ]; then
	/etc/init.d/tailscale enable 2>/dev/null
fi

# fxsd talks AT only through this daemon; enabled so it is up before fxsd.
if [ -x /etc/init.d/ubus-at-daemon ]; then
	/etc/init.d/ubus-at-daemon enable 2>/dev/null
fi

# qmodem deletes network.wan / network.wanv6 on every hang/redial and only
# recreates them if the dial worker gets that far, which left LuCI showing a
# WAN interface with no preset. This service re-creates them within ~20s.
if [ -x /etc/init.d/qmodem-iface-heal ]; then
	/etc/init.d/qmodem-iface-heal enable 2>/dev/null
	/etc/init.d/qmodem-iface-heal start 2>/dev/null
fi

# TTL 64 on the modem uplink is the point of the image; make sure the service
# is enabled even when /etc/config survived a sysupgrade untouched.
if [ -x /etc/init.d/byte-ttl ]; then
	/etc/init.d/byte-ttl enable 2>/dev/null
	/etc/init.d/byte-ttl start 2>/dev/null
fi

# Spread modem packet processing across all four cores (RPS/XPS on wwan*).
if [ -x /etc/init.d/byte-affinity ]; then
	/etc/init.d/byte-affinity enable 2>/dev/null
	/etc/init.d/byte-affinity start 2>/dev/null
fi

# NSS/ECM flow offload bypasses netfilter, so offloaded flows would keep their
# original TTL and defeat the rewrite above. Keep it installed (so
# /usr/bin/nss-offload can turn it on) but off by default on first boot.
if [ -x /etc/init.d/qca-nss-ecm ]; then
	/etc/init.d/qca-nss-ecm stop 2>/dev/null
	/etc/init.d/qca-nss-ecm disable 2>/dev/null
fi

# Ensure the modem dial interface remains the default route (qmodem can
# leave network.wan.defaultroute unset on a fresh UCI).
if uci -q get network.wan >/dev/null 2>&1; then
	if ! uci -q get network.wan.defaultroute 2>/dev/null | grep -q '^1$'; then
		uci set network.wan.defaultroute='1'
		uci commit network
	fi
fi

exit 0