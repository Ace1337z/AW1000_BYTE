diff --git a/ecm_interface.c b/ecm_interface.c
index 25a815d..3f8ba20 100644
--- a/ecm_interface.c
+++ b/ecm_interface.c
@@ -3007,6 +3007,18 @@ static bool ecm_interface_macvlan_mode_is_valid(struct net_device *dev)
 }
 #endif
 
+/*
+ * ecm_interface_is_modem_dev()
+ *	True for WWAN data netdevs (qmi_wwan_q / rmnet). These are deliberately
+ *	kept off the NSS fast path: the TTL / Hop Limit rewrite is a netfilter
+ *	rule and an accelerated flow bypasses netfilter, so its TTL would reach
+ *	the carrier unchanged.
+ */
+static bool ecm_interface_is_modem_dev(const char *name)
+{
+	return !strncmp(name, "wwan", 4) || !strncmp(name, "rmnet", 5);
+}
+
 /*
  * ecm_interface_establish_and_ref()
  *	Establish an interface instance for the given interface detail.
@@ -3101,6 +3113,24 @@ struct ecm_db_iface_instance *ecm_interface_establish_and_ref(struct ecm_front_e
 	dev_type = dev->type;
 	dev_mtu = dev->mtu;
 
+	/*
+	 * Modem egress must never be accelerated.
+	 *
+	 * Establish the WWAN data netdev as an UNKNOWN interface carrying an
+	 * invalid accelerator interface number. ECM still tracks the connection
+	 * so the LAN/WiFi side behaves normally, but the NSS rule create path
+	 * rejects it (it requires a non-negative AE ifnum) and the connection
+	 * stays on the host stack, where the TTL rewrite always runs.
+	 * Everything else - bridge, LAN<->WiFi, local - is still offloaded.
+	 */
+	if (ecm_interface_is_modem_dev(dev_name)) {
+		DEBUG_TRACE("%px: Net device: %px (%s) is modem egress, excluding from acceleration\n",
+				feci, dev, dev_name);
+		type_info.unknown.os_specific_ident = dev_interface_num;
+		return ecm_interface_unknown_interface_establish(&type_info.unknown, dev_name,
+				dev_interface_num, -1, dev_mtu);
+	}
+
 	/*
 	 * Does the accel engine recognise this interface?
 	 */
